<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <Version>2.0.2</Version>
    <AssemblyVersion>2.0.2.0</AssemblyVersion>
    <FileVersion>2.0.2.0</FileVersion>
    <AssemblyName>Jellyfin.Plugin.ThunderCat</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.ThunderCat</RootNamespace>
    <Authors>drunkleee</Authors>
    <Description>Jellyfin subtitle provider integrating SubtitleCat and Thunder with multilingual search, media-ID extraction, and CID matching.</Description>
    <PackageProjectUrl>https://github.com/jasmineamber/Jellyfin.Subtitle.ThunderCat</PackageProjectUrl>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1510;CA1512;CA1835;CA1848;CA1850;CA1865;CA2016;CA2249</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.10.7</JellyfinVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Common" Version="$(JellyfinVersion)" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" PrivateAssets="all" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.js" />
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

</Project>
