<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <Version>1.4.0</Version>
    <AssemblyName>Emby.Subtitle.ThunderCat</AssemblyName>
    <RootNamespace>Emby.Subtitle.ThunderCat</RootNamespace>
    <Authors>drunkleee</Authors>
    <Description>Lightweight Emby subtitle provider integrating SubtitleCat and Thunder with multilingual search, media-ID extraction, and CID matching.</Description>
    <PackageProjectUrl>https://github.com/drunkleee/Emby.Subtitle.ThunderCat</PackageProjectUrl>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbySdkVersion Condition="'$(EmbySdkVersion)' == ''">4.8.11</EmbySdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="$(EmbySdkVersion)" PrivateAssets="all" />
    <PackageReference Include="System.Memory" Version="4.6.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.js" />
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

</Project>
